# Copy to .env (local) or add as Secrets (Replit) / Environment Variables (Render)
GEMINI_API_KEY=your-key-from-google-ai-studio
# Gemma 4 model that reads images and does the reasoning + co-pilot chat
GEMMA_MODEL=gemma-4-31b-it
# Faster Gemma 4 model for extracting facts from text (cannot read images)
GEMMA_FAST_MODEL=gemma-4-26b-a4b-it
# Optional: an audio-capable Gemma 4 model (E4B / E2B). If unset, audio uses open-source Whisper locally.
GEMMA_AUDIO_MODEL=
# Optional: set to 1 to run without any API key (rule-based stand-in, for UI testing only)
MOCK_AI=0
PORT=3000
# Private mode (optional): Gemma 4 on this computer via Ollama. Install Ollama, then: ollama pull gemma4:e4b
# On a 6 GB GPU, gemma4:e2b is much faster (ollama pull gemma4:e2b); gemma4:e4b is smarter but slower.
LOCAL_MODEL=gemma4:e4b
# Used automatically if the main local model fails (ollama pull gemma4:e2b)
LOCAL_FALLBACK_MODEL=gemma4:e2b
OLLAMA_URL=http://127.0.0.1:11434
# Audio (Whisper). On a Windows laptop with a GPU, WHISPER_DEVICE=dml is usually much faster.
# Smaller/faster model: WHISPER_MODEL=Xenova/whisper-tiny   (base is more accurate)
WHISPER_DEVICE=cpu
WHISPER_MODEL=Xenova/whisper-base
